# Test output
coverage/
*.log

# Credentials of any kind. The legacy repos committed service-account JSON;
# this repo must never do the same.
*.pem
*.key
*-adminsdk*.json
google-services.json
GoogleService-Info.plist
service-account*.json

# TypeScript incremental build state, per-machine and never useful in review.
*.tsbuildinfo
