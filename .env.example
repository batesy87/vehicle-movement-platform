# Copy to .env.local and fill in. Never commit the filled-in copy.

# --- Database -------------------------------------------------------------
# Local development via docker compose (see packages/db/README.md), or the
# connection string from your Supabase project's connection pooler.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# The migration runner and the RLS test suite need a superuser-ish role so they
# can create schemas, roles and SECURITY DEFINER functions. In Supabase this is
# the `postgres` role from the project's direct (non-pooled) connection string.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, so it must never reach the browser
# or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Days of free trial granted to a newly signed-up company.
TRIAL_PERIOD_DAYS=14

# --- Stripe (columns exist in the schema; integration is a later phase) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
